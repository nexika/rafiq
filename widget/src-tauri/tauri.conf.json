{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rafiq",
  "version": "0.1.0",
  "identifier": "dev.nexika.rafiq.widget",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rafiq",
        "width": 340,
        "height": 104,
        "minWidth": 280,
        "minHeight": 88,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "What Rafiq is doing, step by step"
  }
}
